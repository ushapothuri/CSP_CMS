rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {      return request.auth != null;    }
    function isAdmin() {
      return signedIn()        && exists(          /databases/$(database)/documents/admins/$(request.auth.uid)        );    }
    match /users/{uid} {
      allow read, write:
        if signedIn()        && request.auth.uid == uid;
    }
    match /admins/{uid} {
      allow get:
        if signedIn()
        && request.auth.uid == uid;
    }
    match /complaints/{id} {
      allow get, list:
        if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "Submitted"
        && request.resource.data.description.size() <= 1000
        && (
          !('fileName' in request.resource.data)
          || request.resource.data.fileName.size() <= 150
        );

      allow update:
        if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "timeline",
            "updatedAt"
          ]);

      allow delete:
        if signedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAdmin()
        );
    }
    match /attachments/{id} {
      allow get:
        if signedIn()        && (          resource.data.uid == request.auth.uid          || isAdmin()        );
      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == id
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000
        && request.resource.data.name.size() <= 150
        && request.resource.data.type in [
          'image/jpeg',
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ]
        && getAfter(
          /databases/$(database)/documents/complaints/$(id)
        ).data.uid == request.auth.uid;
      allow delete:
        if signedIn()        && (          resource.data.uid == request.auth.uid          || isAdmin()        );    }
    match /tracking/{id} {
      allow read:
        if true;
      allow create:
        if signedIn()
        && request.resource.data.status == "Submitted";
      allow update:
        if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "resolved",
            "timeline"
          ]);
      allow delete:
        if signedIn()
        && (
          isAdmin()
          ||
          (            exists(              /databases/$(database)/documents/complaints/$(id)            )           &&
            get(
              /databases/$(database)/documents/complaints/$(id)
            ).data.uid == request.auth.uid
          )
        );
    }

    match /openIssues/{key} {

      allow get, create:
        if signedIn();

      allow delete:
        if signedIn()
        && (
          isAdmin()
          ||
          resource.data.uid == request.auth.uid
        );
    }

  }
}